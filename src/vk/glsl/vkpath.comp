#version 460
// M8c: the path tracer on the GPU's ray-tracing hardware.
//
// Same job and same outputs as pathtrace.comp (light, sky/fog, surface colour, glow, geometry,
// depth), so the OpenGL denoiser, exposure, FSR and Beta's own drawing carry on unchanged.
// What differs is how a ray finds what it hits: instead of walking the block grid one cell at
// a time, it asks the hardware, which searches a tree of boxes built from each chunk's block
// faces (one small tree per chunk, plus one tree over all the chunks, rebuilt every frame).
//
// The lighting and main() are shared with pathtrace.comp (pt_base.glsl, pt_light.glsl).
// Mobs are boxes from EntityCapture, rebuilt into their own small tree every frame.
#extension GL_EXT_ray_query : require
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_GOOGLE_include_directive : require

layout(local_size_x = 8, local_size_y = 8) in;
#include "vkpath_body.glsl"
