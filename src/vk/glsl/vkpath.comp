#version 460
// M8c: the path tracer on the GPU's ray-tracing hardware.
//
// Same job and same outputs as pathtrace.comp (light, sky/fog, surface colour, glow, geometry,
// depth), so the OpenGL denoiser, exposure, FSR and Beta's own drawing carry on unchanged.
// What differs is how a ray finds what it hits: instead of walking the block grid one cell at
// a time, it asks the hardware, which searches a tree of boxes built from each chunk's block
// faces (one small tree per chunk, plus one tree over all the chunks, rebuilt every frame).
//
// The lighting and main() are shared with pathtrace.comp (pt_base.glsl, pt_light.glsl).
// Mobs are boxes from EntityCapture, rebuilt into their own small tree every frame.
#extension GL_EXT_ray_query : require
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_GOOGLE_include_directive : require

layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 0) uniform accelerationStructureEXT uScene;
layout(set = 0, binding = 1, rgba16f) uniform writeonly image2D outLight;
layout(set = 0, binding = 2, rgba16f) uniform writeonly image2D outSkyFog;
layout(set = 0, binding = 3, rgba16f) uniform writeonly image2D outAlbedo;
layout(set = 0, binding = 4, rgba16f) uniform writeonly image2D outExtra;
layout(set = 0, binding = 5, rgba16f) uniform writeonly image2D outGeom;
layout(set = 0, binding = 12, rgba16f) uniform writeonly image2D outGeom2; // geometry alternates between two pictures (this frame, last frame)
layout(set = 0, binding = 6, r32f)    uniform writeonly image2D outDepth;
layout(set = 0, binding = 7, std140) uniform Params {
    vec4 v[11];
    ivec4 iv[3];
    vec4 fx;   // effects: time (s), wind, rain wetness here, spare
    ivec4 ifx; // effects: FX_* bits, spare
} P;
layout(set = 0, binding = 8, std430) readonly buffer Lights { vec4 lights[]; };
// per triangle (ChunkMesher): id (12 bits) | kind << 12 | tile << 16, tint (0xRRGGBB | 1 << 24 if tinted), packed normal, spare,
// then the texture position at its 3 corners (6 floats), 2 spare
struct Tri { uvec4 a; vec2 uv0; vec2 uv1; vec2 uv2; vec2 pad; };
layout(buffer_reference, std430, buffer_reference_align = 16) readonly buffer TriInfo { Tri tri[]; };
struct ChunkRef { uint64_t info; uint cutoutBase; uint pad; };
layout(set = 0, binding = 9, std430) readonly buffer Chunks { ChunkRef chunks[]; };
layout(set = 0, binding = 10) uniform sampler2D uAtlas;
layout(set = 0, binding = 11) uniform sampler2D uClouds;
layout(set = 0, binding = 13) uniform sampler2DArray uSkins; // every mob skin, one 64 x 64 layer each
layout(set = 0, binding = 14) uniform sampler2D uAtlasS;     // M9: LabPBR specular map, or a 1x1 "none"
layout(set = 0, binding = 15) uniform sampler2D uAtlasN;     // M9: LabPBR normal map, or a 1x1 "none"

#define uCamFrac      P.v[0].xyz
#define uTanHalfFov   P.v[0].w
#define uCamForward   P.v[1].xyz
#define uMaxDist      P.v[1].w
#define uCamRight     P.v[2].xyz
#define uFogStart     P.v[2].w
#define uCamUp        P.v[3].xyz
#define uFogEnd       P.v[3].w
#define uSkyColor     P.v[4].xyz
#define uDaylight     P.v[4].w
#define uFogColor     P.v[5].xyz
#define uRain         P.v[5].w
#define uSunrise      P.v[6]
#define uSunDir       P.v[7].xyz
#define uAmbient      P.v[7].w
#define uMoon         P.v[8].x
#define uLowSunK      P.v[8].y
#define uSkySat       P.v[8].z
#define uSkyFill      P.v[8].w
#define uJitter       P.v[9].xy
#define uCloudShadow  P.v[9].z
#define uLavaGlow     P.v[9].w
#define uCloud        P.v[10]
#define uResolution   P.iv[0].xy
#define uFrame        P.iv[0].z
#define uLightCount   P.iv[0].w
#define uCamBlock     P.iv[1].xyz
#define uDebugMask    P.iv[1].w
#define uGeomIndex    P.iv[2].x
#define uReflections  P.iv[2].y
#define uPbr          P.iv[2].z
#define uBounces      P.iv[2].w
#define uTime         P.fx.x
#define uWind         P.fx.y
#define uWet          P.fx.z
#define uEffects      P.ifx.x
#define uHandEnt      P.ifx.y   // 1 + the traced hand's mob index when blocks mustn't hide it (Hand collision: OFF), else 0
#define uGrassOverlay P.ifx.z   // Fancy graphics: 1 + the tile laid over grass sides (ChunkMesher marks them), 0 on Fast
#define uCamInWater   P.ifx.w   // 1 while the camera is under water
const uint MASK_SOLID = 1u, MASK_CLEAR = 2u, MASK_MOBS = 4u;
const uint KIND_CROSS = 1u, KIND_MOB = 2u, KIND_FACE2 = 3u; // FACE2: one square between two touching see-through blocks

const float PI = 3.14159265;
#define BLOCKLUM_DECL layout(set = 0, binding = 16, std430) readonly buffer BlockLum { uint blockLum[]; };
#include "version.glsl"
#include "pt_base.glsl"

const vec3 FACE_N[6] = vec3[](vec3(0, -1, 0), vec3(0, 1, 0), vec3(0, 0, -1), vec3(0, 0, 1), vec3(-1, 0, 0), vec3(1, 0, 0));

int tileSize() { return textureSize(uAtlas, 0).x / int(GRID_COLS); }
vec4 atlas(uint tile, vec2 uv) {
    int ts = tileSize();
    ivec2 t = ivec2(int(tile & (GRID_COLS - 1u)), int(tile >> GRID_SHIFT)) * ts;
    ivec2 px = t + clamp(ivec2(floor(uv * float(ts))), ivec2(0), ivec2(ts - 1));
    return texelFetch(uAtlas, px, 0);
}
vec2 faceUV(int face, vec3 p) {
    if (face <= 1) return vec2(p.x, p.z);
    if (face == 2) return vec2(1.0 - p.x, 1.0 - p.y);
    if (face == 3) return vec2(p.x, 1.0 - p.y);
    if (face == 4) return vec2(p.z, 1.0 - p.y);
    return vec2(1.0 - p.z, 1.0 - p.y);
}

// ---------------------------------------------------------------- hardware ray queries
// Two passes per ray: solid things first (full cubes; then anything with see-through pixels, where the
// shader checks the pixel), then water and ice up to what the first pass hit, which only tint and dim.
struct Hit {
    bool hit; float t; vec3 n; vec3 albedo; uint id; float glow;
    vec3 transmit;                                        // colour that got through water/ice on the way
    bool water; vec3 waterColor; vec3 waterN; float waterAlpha; float waterT; // first water/ice surface (camera rays) and its face
    uint ent;                                             // 0 = the world, else 1 + index of the mob hit (motion)
    uint tile; vec2 uv;                                   // M9: atlas tile and position at the hit (tile >= 256: none)
    bool glass; float glassT; vec3 glassN;                // M9: nearest clear glass pixel a camera ray went through
};

Tri triAt(uint index, uint geometry, uint prim) {
    ChunkRef c = chunks[index];
    return TriInfo(c.info).tri[(geometry == 1u ? c.cutoutBase : 0u) + prim];
}
vec3 unpackNormal(uint p) {
    return normalize(vec3(float(int(p << 24) >> 24), float(int(p << 16) >> 24), float(int(p << 8) >> 24)));
}
uint kindOf(Tri t) { return (t.a.x >> 12) & 15u; }
vec3 unpackSrgb(uint c) { return vec3((c >> 16) & 255u, (c >> 8) & 255u, c & 255u) / 255.0; }

// A mob box: its skin pixel (uv in skin pixels, layer in the low 16 bits, 0 = no skin), dyed by its tint
// (stored in display colours), then any hurt/creeper flash laid over in display colours, as Beta blends it.
vec4 mobTexel(Tri t, vec2 uv, out vec3 linearColour) {
    uint layer = t.a.x & 4095u;
    vec3 tint = unpackSrgb(t.a.y);
    vec4 tex = vec4(1.0);
    if (layer > 0u) tex = texelFetch(uSkins, ivec3(clamp(ivec2(floor(uv)), ivec2(0), ivec2(63, 63)), int(layer) - 1), 0);
    vec3 srgb = tex.rgb * tint;
    float oa = float(t.a.w >> 24) / 255.0;
    if (oa > 0.0) srgb = mix(srgb, unpackSrgb(t.a.w), oa);
    linearColour = srgbToLinear(srgb);
    return tex;
}

vec4 texel(Tri t, vec2 bary, vec3 wp) {
    vec2 uv = t.uv0 * (1.0 - bary.x - bary.y) + t.uv1 * bary.x + t.uv2 * bary.y;
    // Waving plants (Effects): wp is the hit point (camera block at the origin), nudged into the block hit
    if (kindOf(t) != KIND_MOB) uv += swayUV(t.a.x & 4095u, ivec3(floor(wp)) + uCamBlock, fract(wp.y));
    if (kindOf(t) == KIND_MOB) { vec3 c; vec4 m = mobTexel(t, uv, c); return vec4(pow(c, vec3(1.0 / 2.2)), m.a); }
    vec4 tex = atlas((t.a.x >> 16), uv);
    if ((t.a.y & (1u << 24)) != 0u) tex.rgb *= vec3((t.a.y >> 16) & 255u, (t.a.y >> 8) & 255u, t.a.y & 255u) / 255.0;
    // Fancy grass: a grass side (ChunkMesher sets bit 25 and the biome's colour) gets Beta's grass edge in that colour
    if ((t.a.y & (1u << 25)) != 0u && uGrassOverlay > 0) {
        vec4 ov = atlas(uint(uGrassOverlay - 1), uv);
        tex.rgb = mix(tex.rgb, ov.rgb * vec3((t.a.y >> 16) & 255u, (t.a.y >> 8) & 255u, t.a.y & 255u) / 255.0, step(0.1, ov.a)); // drawn with alpha test, as Beta does: a pixel covers or it doesn't
    }
    return tex;
}
// Leaves while gSolidLeaves (the bounce light, the effects' rays): Beta's solid leaf texture, the tile after
// the see-through one (as Leaves: Fast meshes them), tinted the same way
bool solidLeafTri(Tri t) { return gSolidLeaves && kindOf(t) != KIND_MOB && (t.a.x & 4095u) == 18u; }
vec4 solidLeafTexel(Tri t, vec2 bary) {
    vec2 uv = t.uv0 * (1.0 - bary.x - bary.y) + t.uv1 * bary.x + t.uv2 * bary.y;
    vec4 tex = atlas((t.a.x >> 16) + 1u, uv);
    if ((t.a.y & (1u << 24)) != 0u) tex.rgb *= vec3((t.a.y >> 16) & 255u, (t.a.y >> 8) & 255u, t.a.y & 255u) / 255.0;
    return vec4(tex.rgb, 1.0);
}

// A see-through face counts only where the ray goes into its block through it, like the OpenGL grid walk,
// which only looks at a cell's entry side (two leaf blocks touching share one face, not two).
// Mobs: Beta draws every face of a box, so a far face shows through see-through pixels (chicken legs).
bool counts(Tri t, vec3 d) { uint k = kindOf(t); return k == KIND_CROSS || k == KIND_MOB || k == KIND_FACE2 || dot(d, unpackNormal(t.a.z)) < 0.0; }
// a two-sided square faces whichever way the ray came from
vec3 faceNormal(Tri t, vec3 d) { vec3 n = unpackNormal(t.a.z); return kindOf(t) == KIND_FACE2 && dot(d, n) > 0.0 ? -n : n; }

const vec3 WATER_ABSORB = vec3(0.55, 0.32, 0.10); // per block travelled, as pathtrace.comp

Hit trace(vec3 o, vec3 d, float maxT, bool anyHit, bool primary) {
    Hit h;
    h.hit = false; h.t = maxT; h.n = vec3(0, 1, 0); h.albedo = vec3(0.0); h.id = 0u; h.glow = 1.0;
    h.transmit = vec3(1.0); h.water = false; h.waterColor = vec3(0.0); h.waterN = vec3(0.0, 1.0, 0.0); h.waterAlpha = 0.0; h.waterT = 0.0; h.ent = 0u; h.tile = 65535u; h.uv = vec2(0.0);
    h.glass = false; h.glassT = 1e30; h.glassN = vec3(0, 1, 0);

    rayQueryEXT q;
    rayQueryInitializeEXT(q, uScene, anyHit ? gl_RayFlagsTerminateOnFirstHitEXT : gl_RayFlagsNoneEXT, MASK_SOLID, o, 0.0, d, maxT);
    while (rayQueryProceedEXT(q)) {
        if (rayQueryGetIntersectionTypeEXT(q, false) == gl_RayQueryCandidateIntersectionTriangleEXT) {
            Tri t = triAt(rayQueryGetIntersectionInstanceCustomIndexEXT(q, false), rayQueryGetIntersectionGeometryIndexEXT(q, false),
                          rayQueryGetIntersectionPrimitiveIndexEXT(q, false));
            if (!counts(t, d)) continue;
            if (solidLeafTri(t) || texel(t, rayQueryGetIntersectionBarycentricsEXT(q, false), o + d * (rayQueryGetIntersectionTEXT(q, false) + 1e-3)).a > ALPHA_CUT) rayQueryConfirmIntersectionEXT(q);
            else if (primary && (t.a.x & 4095u) == 20u && kindOf(t) != KIND_MOB) {
                // M9: a clear glass pixel: the ray goes on, but remember the nearest one (it reflects a little)
                float tc = rayQueryGetIntersectionTEXT(q, false);
                if (tc < h.glassT) { h.glass = true; h.glassT = tc; h.glassN = faceNormal(t, d); }
            }
        }
    }
    if (rayQueryGetIntersectionTypeEXT(q, true) == gl_RayQueryCommittedIntersectionTriangleEXT) {
        h.hit = true;
        h.t = rayQueryGetIntersectionTEXT(q, true);
        if (!anyHit) {
            Tri t = triAt(rayQueryGetIntersectionInstanceCustomIndexEXT(q, true), rayQueryGetIntersectionGeometryIndexEXT(q, true),
                          rayQueryGetIntersectionPrimitiveIndexEXT(q, true));
            vec4 tex = solidLeafTri(t) ? solidLeafTexel(t, rayQueryGetIntersectionBarycentricsEXT(q, true))
                                       : texel(t, rayQueryGetIntersectionBarycentricsEXT(q, true), o + d * (h.t + 1e-3));
            h.n = faceNormal(t, d);
            h.albedo = srgbToLinear(tex.rgb);
            h.id = kindOf(t) == KIND_MOB ? 0u : t.a.x & 4095u;
            h.ent = kindOf(t) == KIND_MOB ? uint(t.pad.x + 0.5) : 0u;
            if (kindOf(t) != KIND_MOB) {
                vec2 bc = rayQueryGetIntersectionBarycentricsEXT(q, true);
                h.tile = (t.a.x >> 16);
                h.uv = t.uv0 * (1.0 - bc.x - bc.y) + t.uv1 * bc.x + t.uv2 * bc.y;
            }
            bool flame = h.id == 50u || h.id == 51u || h.id == 76u;
            h.glow = flame ? smoothstep(0.55, 0.85, max(tex.r, max(tex.g, tex.b))) : 1.0;
        }
    }
    if (h.hit && anyHit) return h; // a shadow ray stopped by something solid: no need to look at water

    // Hand collision OFF: a camera ray sees the traced hand even where a block is nearer (standing against a wall,
    // the hand reaches into it; Beta draws it on top). It's lit from just in front of that block. Only the hand's
    // triangles are accepted, within 3 blocks of the eye: only the mobs' instance is searched, and NoOpaque makes
    // every triangle a candidate (an opaque one would be accepted on its own, and blocks are opaque).
    if (primary && uHandEnt > 0 && h.ent != uint(uHandEnt)) {
        float tw = h.hit ? h.t : maxT;
        rayQueryEXT qh;
        rayQueryInitializeEXT(qh, uScene, gl_RayFlagsNoOpaqueEXT, MASK_MOBS, o, 0.0, d, 3.0);
        while (rayQueryProceedEXT(qh)) {
            if (rayQueryGetIntersectionTypeEXT(qh, false) != gl_RayQueryCandidateIntersectionTriangleEXT) continue;
            Tri t = triAt(rayQueryGetIntersectionInstanceCustomIndexEXT(qh, false), rayQueryGetIntersectionGeometryIndexEXT(qh, false),
                          rayQueryGetIntersectionPrimitiveIndexEXT(qh, false));
            if (kindOf(t) != KIND_MOB || uint(t.pad.x + 0.5) != uint(uHandEnt) || !counts(t, d)) continue;
            if (texel(t, rayQueryGetIntersectionBarycentricsEXT(qh, false), o + d * (rayQueryGetIntersectionTEXT(qh, false) + 1e-3)).a > ALPHA_CUT)
                rayQueryConfirmIntersectionEXT(qh);
        }
        if (rayQueryGetIntersectionTypeEXT(qh, true) == gl_RayQueryCommittedIntersectionTriangleEXT && rayQueryGetIntersectionTEXT(qh, true) > tw) {
            Tri t = triAt(rayQueryGetIntersectionInstanceCustomIndexEXT(qh, true), rayQueryGetIntersectionGeometryIndexEXT(qh, true),
                          rayQueryGetIntersectionPrimitiveIndexEXT(qh, true));
            vec4 tex = texel(t, rayQueryGetIntersectionBarycentricsEXT(qh, true), o + d * (rayQueryGetIntersectionTEXT(qh, true) + 1e-3));
            h.hit = true; h.t = max(tw - 0.02, 1e-3); h.n = faceNormal(t, d); h.albedo = srgbToLinear(tex.rgb);
            h.id = 0u; h.ent = uint(uHandEnt); h.glow = 1.0; h.tile = 65535u; h.uv = vec2(0.0);
            h.glass = false;
            return h; // in front of everything, as Beta draws it: no water or ice tint
        }
    }

    // water and ice in front of what was hit (or to maxT): each surface the ray goes into tints it,
    // and every block of water it passes through dims it, more in red than in blue
    float tEnd = h.hit ? h.t : maxT;
    rayQueryInitializeEXT(q, uScene, gl_RayFlagsNoneEXT, MASK_CLEAR, o, 0.0, d, tEnd);
    float enterSum = 0.0, exitSum = 0.0;
    int enters = 0, exits = 0;
    if (primary && uCamInWater != 0) enters = 1; // a camera ray starts under water: it went in at t = 0
    while (rayQueryProceedEXT(q)) {
        if (rayQueryGetIntersectionTypeEXT(q, false) != gl_RayQueryCandidateIntersectionTriangleEXT) continue;
        float tc = rayQueryGetIntersectionTEXT(q, false);
        Tri t = triAt(rayQueryGetIntersectionInstanceCustomIndexEXT(q, false), 0u, rayQueryGetIntersectionPrimitiveIndexEXT(q, false));
        uint id = t.a.x & 4095u;
        bool isWater = id == 8u || id == 9u;
        if (dot(d, unpackNormal(t.a.z)) < 0.0) {             // going in
            vec4 tex = texel(t, rayQueryGetIntersectionBarycentricsEXT(q, false), o + d * (tc + 1e-3));
            vec3 alb = srgbToLinear(tex.rgb);
            float a = clamp(tex.a, 0.35, 0.9);
            h.transmit *= mix(vec3(1.0), alb * 1.4, a);
            if (isWater) { enterSum += tc; enters++; }
            if (primary && (!h.water || tc < h.waterT)) { h.water = true; h.waterColor = alb; h.waterN = unpackNormal(t.a.z); h.waterAlpha = a; h.waterT = tc; }
        } else if (isWater) {                                  // coming out
            exitSum += tc; exits++;
        }
    }
    // water path length: every exit minus every entry, plus the end of the ray if it's still underwater there
    float waterLen = exitSum - enterSum + float(max(enters - exits, 0)) * tEnd;
    if (enters + exits > 0) h.transmit *= exp(-WATER_ABSORB * max(waterLen, 0.0));
    return h;
}

// Vulkan's side of the shared code: rays ask the ray-tracing hardware
Hit traceRay(vec3 o, vec3 d, float maxT, bool primary) { return trace(o, d, maxT, false, primary); }
Hit traceShadow(vec3 o, vec3 d, float maxT) { return trace(o, d, maxT, true, false); }
void storeGeom(ivec2 px, vec4 g) { if (uGeomIndex == 0) imageStore(outGeom, px, g); else imageStore(outGeom2, px, g); }

#include "pt_light.glsl"
