void ComputeUpsampledColorAndWeight(const AccumulationPassCommonParams params, inout AccumulationPassData data)
{
    const vec2 fDstOutputPos = vec2(params . iPxHrPos)+ vec2(float(0.5f));
    const vec2 fSrcOutputPos = fDstOutputPos * DownscaleFactor();
    const ivec2 iSrcInputPos = ivec2(floor(fSrcOutputPos));
    const vec2 fSrcUnjitteredPos =(vec2(iSrcInputPos)+ vec2(0.5f, 0.5f))- Jitter();
    const vec2 fBaseSampleOffset = vec2(fSrcUnjitteredPos - fSrcOutputPos);
             ivec2 offsetTL;
    offsetTL . x =(fSrcUnjitteredPos . x > fSrcOutputPos . x)? int(- 2): int(- 1);
    offsetTL . y =(fSrcUnjitteredPos . y > fSrcOutputPos . y)? int(- 2): int(- 1);
    const bool bFlipRow = fSrcUnjitteredPos . y > fSrcOutputPos . y;
    const bool bFlipCol = fSrcUnjitteredPos . x > fSrcOutputPos . x;
    const vec2 fOffsetTL = vec2(offsetTL);
    const bool bIsInitialSample =(params . fAccumulation == 0.0f);
               vec3 fSamples[9];
           int iSampleIndex = 0;
    for(int row = 0;row < 3;row ++){
        for(int col = 0;col < 3;col ++){
            const ivec2 iSampleColRow = ivec2(bFlipCol ?(3 - col): col, bFlipRow ?(3 - row): row);
            const ivec2 iSrcSamplePos = ivec2(iSrcInputPos)+ offsetTL + iSampleColRow;
            const ivec2 iSampleCoord = ClampLoad(iSrcSamplePos, ivec2(0, 0), ivec2(RenderSize()));
            fSamples[iSampleIndex]= LoadPreparedColor(iSampleCoord);
            ++ iSampleIndex;
        }
    }
    const float fKernelBiasMax = ComputeMaxKernelWeight(params, data);
    const float fKernelBiasMin = ffxMax(1.0f,((1.0f + fKernelBiasMax)* 0.3f));
    const float fKernelBiasWeight =
        ffxMin(1.0f - params . fDisocclusion * 0.5f,
        ffxMin(1.0f - params . fShadingChange,
        ffxSaturate(data . fHistoryWeight * 5.0f)
        ));
    const float fKernelBias = ffxLerp(fKernelBiasMin, fKernelBiasMax, fKernelBiasWeight);
    iSampleIndex = 0;
    for(int row = 0;row < 3;row ++)
    {
        for(int col = 0;col < 3;col ++)
        {
            const ivec2 sampleColRow = ivec2(bFlipCol ?(3 - col): col, bFlipRow ?(3 - row): row);
            const vec2 fOffset = fOffsetTL + vec2(sampleColRow);
            const vec2 fSrcSampleOffset = fBaseSampleOffset + fOffset;
            const ivec2 iSrcSamplePos = ivec2(iSrcInputPos)+ ivec2(offsetTL)+ sampleColRow;
            const float fOnScreenFactor = float(IsOnScreen(ivec2(iSrcSamplePos), ivec2(RenderSize())));
            if(! bIsInitialSample)
            {
                const float fSampleWeight = fOnScreenFactor * float(GetUpsampleLanczosWeight(fSrcSampleOffset, fKernelBias));
                data . fUpsampledColor += fSamples[iSampleIndex]* fSampleWeight;
                data . fUpsampledWeight += fSampleWeight;
            }
            {
                const float fRectificationCurveBias = - 2.3f;
                const float fSrcSampleOffsetSq = dot(fSrcSampleOffset, fSrcSampleOffset);
                const float fBoxSampleWeight = exp(fRectificationCurveBias * fSrcSampleOffsetSq)* fOnScreenFactor;
                const bool bInitialSample =(row == 0)&&(col == 0);
                RectificationBoxAddSample(bInitialSample, data . clippingBox, fSamples[iSampleIndex], fBoxSampleWeight);
            }
            ++ iSampleIndex;
        }
    }
    RectificationBoxComputeVarianceBoxData(data . clippingBox);
    data . fUpsampledWeight *= float(data . fUpsampledWeight > FSR3UPSCALER_EPSILON);
    if(data . fUpsampledWeight > FSR3UPSCALER_EPSILON){
        data . fUpsampledColor = data . fUpsampledColor / data . fUpsampledWeight;
        data . fUpsampledWeight *= fAverageLanczosWeightPerFrame;
        Deringing(data . clippingBox, data . fUpsampledColor);
    }
    if(bIsInitialSample){
        data . fUpsampledColor = data . clippingBox . boxCenter;
        data . fUpsampledWeight = 1.0f;
        data . fHistoryWeight = 0.0f;
    }
}
