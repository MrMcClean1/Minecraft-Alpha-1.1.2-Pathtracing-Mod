void RectifyHistory(
    const AccumulationPassCommonParams params,
                      inout AccumulationPassData data
)
{
    const float f4kVelocityFactor = ffxSaturate(params . f4KVelocity / 20.0f);
    const float fDistanceFactor = ffxSaturate(0.75f - params . fFarthestDepthInMeters / 20.0f);
    const float fAccumulationFactor = 1.0f - params . fAccumulation;
    const float fReactiveFactor = ffxPow(params . fReactiveMask, 1.0f / 2.0f);
    const float fShadingChangeFactor = params . fShadingChange;
    const float fBoxScaleT = ffxMax(f4kVelocityFactor, ffxMax(fDistanceFactor, ffxMax(fAccumulationFactor, ffxMax(fReactiveFactor, fShadingChangeFactor))));
    const float fBoxScale = ffxLerp(3.0f, 1.0f, fBoxScaleT);
    const vec3 fScaledBoxVec = data . clippingBox . boxVec * vec3(1.7f, 1.0f, 1.0f)* fBoxScale;
    const vec3 fClampedScaledBoxVec = ffxMax(fScaledBoxVec, vec3(1.193e-7f, 1.193e-7f, 1.193e-7f));
    const vec3 fTransformedHistoryColor =(data . fHistoryColor - data . clippingBox . boxCenter)/ fClampedScaledBoxVec;
    if(length(fTransformedHistoryColor)> 1.f){
        const vec3 fClampedHistoryColor = normalize(fTransformedHistoryColor);
        const vec3 fFinalClampedHistoryColor =(fClampedHistoryColor * fScaledBoxVec)+ data . clippingBox . boxCenter;
        const float fHistoryContribution = ffxMax(params . fLumaInstabilityFactor, data . fLockContributionThisFrame)* params . fAccumulation *(1 - params . fDisocclusion);
