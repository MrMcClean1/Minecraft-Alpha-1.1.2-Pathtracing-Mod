         float ComputeThinFeatureConfidence(ivec2 iPxPos)
{
    const int iNucleusIndex = 0;
    const int iSampleCount = 9;
    const ivec2 iSampleOffsets[iSampleCount]= {
                 ivec2(+ 0, + 0),
                 ivec2(- 1, - 1),
                 ivec2(+ 0, - 1),
                 ivec2(+ 1, - 1),
                 ivec2(- 1, + 0),
                 ivec2(+ 1, + 0),
                 ivec2(- 1, + 1),
                 ivec2(+ 0, + 1),
                 ivec2(+ 1, + 1),
    };
             float fSamples[iSampleCount];
             float fLumaMin = FSR3UPSCALER_FP32_MAX;
             float fLumaMax = FSR3UPSCALER_FP32_MIN;
    for(int iSampleIndex = 0;iSampleIndex < iSampleCount;++ iSampleIndex){
        const ivec2 iPxSamplePos = ClampLoad(iPxPos, iSampleOffsets[iSampleIndex], ivec2(RenderSize()));
        fSamples[iSampleIndex]= LoadCurrentLuma(iPxSamplePos)* Exposure();
        fLumaMin = ffxMin(fLumaMin, fSamples[iSampleIndex]);
        fLumaMax = ffxMax(fLumaMax, fSamples[iSampleIndex]);
    }
    const float fThreshold = 0.9f;
             float fDissimilarLumaMin = FSR3UPSCALER_FP32_MAX;
             float fDissimilarLumaMax = 0;
            uint uPatternMask =(1U << iNucleusIndex);
    const uint uNumRejectionMasks = 4;
    const uint uRejectionMasks[uNumRejectionMasks]= {
                (1U << 1)|(1U << 2)|(1U << 4)|(1U << iNucleusIndex),
                (1U << 2)|(1U << 3)|(1U << 5)|(1U << iNucleusIndex),
                (1U << 4)|(1U << 6)|(1U << 7)|(1U << iNucleusIndex),
                (1U << 5)|(1U << 7)|(1U << 8)|(1U << iNucleusIndex)
    };
           int iBitIndex = 1;
    for(int iSampleIndex = 1;iSampleIndex < iSampleCount;++ iSampleIndex, ++ iBitIndex){
        const float fDifference = abs(fSamples[iSampleIndex]- fSamples[iNucleusIndex])/(fLumaMax - fLumaMin);
        if(fDifference < fThreshold)
        {
            uPatternMask |=(1U << iBitIndex);
        }
        else
        {
            fDissimilarLumaMin = ffxMin(fDissimilarLumaMin, fSamples[iSampleIndex]);
            fDissimilarLumaMax = ffxMax(fDissimilarLumaMax, fSamples[iSampleIndex]);
        }
    }
    const bool bIsRidge = fSamples[iNucleusIndex]> fDissimilarLumaMax || fSamples[iNucleusIndex]< fDissimilarLumaMin;
    if((false)== bIsRidge)
    {
        return 0.0f;
    }
    for(int i = 0;i < uNumRejectionMasks;i ++)
    {
        if((uPatternMask & uRejectionMasks[i])== uRejectionMasks[i])
        {
            return 0.0f;
        }
    }
    return 1.0f - fLumaMin / fLumaMax;
}
         float UpdateAccumulation(ivec2 iPxPos, vec2 fUv, vec2 fMotionVector, float fDisocclusion, float fShadingChange)
{
    const vec2 fReprojectedUv = fUv + fMotionVector;
             float fAccumulation = 0.0f;
    if(IsUvInside(fReprojectedUv)){
        const vec2 fReprojectedUv_HW = ClampUv(fReprojectedUv, PreviousFrameRenderSize(), MaxRenderSize());
        fAccumulation = ffxSaturate(SampleAccumulation(fReprojectedUv_HW));
    }
    const float fAccumulationAddedPerFrame = AccumulationAddedPerFrame();
    fAccumulation = ffxLerp(fAccumulation, 0.0f, fShadingChange);
    const float fMinDisocclusionAccumulation = MinDisocclusionAccumulation();
    fAccumulation = ffxLerp(fAccumulation, ffxMin(fMinDisocclusionAccumulation, fAccumulation), fDisocclusion);
    fAccumulation *= float(round(fAccumulation * 100.0f)> 1.0f);
    const float fAccumulatedFramesToStore = ffxSaturate(fAccumulation + fAccumulationAddedPerFrame);
    StoreAccumulation(iPxPos, fAccumulatedFramesToStore);
    return fAccumulation;
}
         float ComputeShadingChange(vec2 fUv)
{
    const vec2 fShadingChangeUv = ClampUv(fUv - Jitter()/ RenderSize(), ShadingChangeRenderSize(), ShadingChangeMaxRenderSize());
    const float fShadingChange = ffxSaturate(SampleShadingChange(fShadingChangeUv));
    return fShadingChange;
