         float ComputeDisocclusions(vec2 fUv, vec2 fMotionVector, float fCurrentDepthViewSpace)
{
    const float fNearestDepthInMeters = ffxMin(fCurrentDepthViewSpace * ViewSpaceToMetersFactor(), FSR3UPSCALER_FP16_MAX);
    const float fReconstructedDeptMvThreshold = ReconstructedDepthMvPxThreshold(fNearestDepthInMeters);
    fMotionVector *= float(Get4KVelocity(fMotionVector)> fReconstructedDeptMvThreshold);
    const vec2 fReprojectedUv = fUv + fMotionVector;
    const BilinearSamplingData bilinearInfo = GetBilinearSamplingData(fReprojectedUv, RenderSize());
             float fDisocclusion = 0.0f;
             float fWeightSum = 0.0f;
             bool bPotentialDisocclusion = true;
    for(int iSampleIndex = 0;iSampleIndex < 4 && bPotentialDisocclusion;iSampleIndex ++)
    {
        const ivec2 iOffset = bilinearInfo . iOffsets[iSampleIndex];
        const ivec2 iSamplePos = ClampLoad(bilinearInfo . iBasePos, iOffset, ivec2(RenderSize()));
        if(IsOnScreen(iSamplePos, RenderSize())){
            const float fWeight = bilinearInfo . fWeights[iSampleIndex];
            if(fWeight > fReconstructedDepthBilinearWeightThreshold){
                const float fPrevNearestDepthViewSpace = GetViewSpaceDepth(LoadReconstructedPrevDepth(iSamplePos));
                const float fDepthDifference = fCurrentDepthViewSpace - fPrevNearestDepthViewSpace;
                bPotentialDisocclusion = bPotentialDisocclusion &&(fDepthDifference > FSR3UPSCALER_FP32_MIN);
                if(bPotentialDisocclusion){
                    const float fHalfViewportWidth = length(vec2(RenderSize())* 0.5f);
                    const float fDepthThreshold = ffxMax(fCurrentDepthViewSpace, fPrevNearestDepthViewSpace);
                    const float Ksep = 1.37e-05f;
                    const float fRequiredDepthSeparation = Ksep * fHalfViewportWidth * fDepthThreshold;
                    fDisocclusion += ffxSaturate(float(fRequiredDepthSeparation / fDepthDifference))* fWeight;
                    fWeightSum += fWeight;
                }
            }
        }
    }
    fDisocclusion =(bPotentialDisocclusion && fWeightSum > 0)? ffxSaturate(1.0f - fDisocclusion / fWeightSum): 0.0f;
    return fDisocclusion;
}
         float ComputeMotionDivergence(vec2 fUv, vec2 fMotionVector, float fCurrentDepthSample)
{
    const ivec2 iPxReprojectedPos = ivec2((fUv + fMotionVector)* RenderSize());
    const float fReprojectedDepth = LoadDilatedDepth(iPxReprojectedPos);
    const vec2 fReprojectedMotionVector = LoadDilatedMotionVector(iPxReprojectedPos);
    const float fReprojectedVelocity = Get4KVelocity(fReprojectedMotionVector);
    const float f4KVelocity = Get4KVelocity(fMotionVector);
    const float fMaxLen = max(length(fMotionVector), length(fReprojectedMotionVector));
    const float fNucleusDepthInMeters = GetViewSpaceDepthInMeters(fReprojectedDepth);
    const float fCurrentDepthInMeters = GetViewSpaceDepthInMeters(fCurrentDepthSample);
    const float fDistanceFactor = MinDividedByMax(fNucleusDepthInMeters, fCurrentDepthInMeters);
    const float fVelocityFactor = ffxSaturate(f4KVelocity / 10.0f);
    const float fMotionVectorFieldConfidence =(1.0f - ffxSaturate(fReprojectedVelocity / f4KVelocity))* fDistanceFactor * fVelocityFactor;
    return fMotionVectorFieldConfidence;
}
         float DilateReactiveMasks(ivec2 iPxPos, vec2 fUv)
{
             float fDilatedReactiveMasks = 0.0f;
    for(int y = - 1;y <= 1;y ++)
    {
        for(int x = - 1;x <= 1;x ++)
        {
            const ivec2 sampleCoord = ClampLoad(iPxPos, ivec2(x, y), ivec2(RenderSize()));
            fDilatedReactiveMasks = ffxMax(fDilatedReactiveMasks, LoadReactiveMask(sampleCoord));
