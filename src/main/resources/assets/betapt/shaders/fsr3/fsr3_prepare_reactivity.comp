void PrepareReactivity(ivec2 iPxPos)
{
    const vec2 fUv =(iPxPos + 0.5f)/ RenderSize();
    const vec2 fMotionVector = LoadDilatedMotionVector(iPxPos);
    const float f4KVelocity = Get4KVelocity(fMotionVector);
    const vec2 fDilatedUv = fUv + fMotionVector;
    const float fDilatedDepth = LoadDilatedDepth(iPxPos);
    const float fDepthInMeters = GetViewSpaceDepthInMeters(fDilatedDepth);
    const float fDisocclusion = ComputeDisocclusions(fUv, fMotionVector, GetViewSpaceDepth(fDilatedDepth));
    const float fShadingChange = ffxMax(DilateReactiveMasks(iPxPos, fUv), ComputeShadingChange(fUv));
    const float fMotionDivergence = ComputeMotionDivergence(fUv, fMotionVector, fDilatedDepth);
    const float fDilatedTransparencyAndComposition = DilateTransparencyAndCompositionMasks(iPxPos, fUv);
    const float fFinalReactiveness = ffxMax(fMotionDivergence, fDilatedTransparencyAndComposition);
    const float fAccumulation = UpdateAccumulation(iPxPos, fUv, fMotionVector, fDisocclusion, fShadingChange);
               vec4 fOutput;
    fOutput[REACTIVE]= fFinalReactiveness;
    fOutput[DISOCCLUSION]= fDisocclusion;
    fOutput[SHADING_CHANGE]= fShadingChange;
    fOutput[ACCUMULAION]= fAccumulation;
    StoreDilatedReactiveMasks(iPxPos, fOutput);
    const float fLockStrength = ComputeThinFeatureConfidence(iPxPos);
    if(fLockStrength >(1.0f / 100.0f))
    {
        StoreNewLocks(ComputeHrPosFromLrPos(ivec2(iPxPos)), fLockStrength);
    }
}
