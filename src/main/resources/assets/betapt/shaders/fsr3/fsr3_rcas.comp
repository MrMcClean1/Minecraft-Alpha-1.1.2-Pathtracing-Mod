           void ffxFsrPopulateEasuConstants(
                      inout uvec4 con0,
                      inout uvec4 con1,
                      inout uvec4 con2,
                      inout uvec4 con3,
                   in float inputViewportInPixelsX,
                   in float inputViewportInPixelsY,
                   in float inputSizeInPixelsX,
                   in float inputSizeInPixelsY,
                   in float outputSizeInPixelsX,
                   in float outputSizeInPixelsY)
{
    con0[0]= ffxAsUInt32(inputViewportInPixelsX * ffxReciprocal(outputSizeInPixelsX));
    con0[1]= ffxAsUInt32(inputViewportInPixelsY * ffxReciprocal(outputSizeInPixelsY));
    con0[2]= ffxAsUInt32(float(0.5)* inputViewportInPixelsX * ffxReciprocal(outputSizeInPixelsX)- float(0.5));
    con0[3]= ffxAsUInt32(float(0.5)* inputViewportInPixelsY * ffxReciprocal(outputSizeInPixelsY)- float(0.5));
    con1[0]= ffxAsUInt32(ffxReciprocal(inputSizeInPixelsX));
    con1[1]= ffxAsUInt32(ffxReciprocal(inputSizeInPixelsY));
    con1[2]= ffxAsUInt32(float(1.0)* ffxReciprocal(inputSizeInPixelsX));
    con1[3]= ffxAsUInt32(float(- 1.0)* ffxReciprocal(inputSizeInPixelsY));
    con2[0]= ffxAsUInt32(float(- 1.0)* ffxReciprocal(inputSizeInPixelsX));
    con2[1]= ffxAsUInt32(float(2.0)* ffxReciprocal(inputSizeInPixelsY));
    con2[2]= ffxAsUInt32(float(1.0)* ffxReciprocal(inputSizeInPixelsX));
    con2[3]= ffxAsUInt32(float(2.0)* ffxReciprocal(inputSizeInPixelsY));
    con3[0]= ffxAsUInt32(float(0.0)* ffxReciprocal(inputSizeInPixelsX));
    con3[1]= ffxAsUInt32(float(4.0)* ffxReciprocal(inputSizeInPixelsY));
    con3[2]= con3[3]= 0;
}
