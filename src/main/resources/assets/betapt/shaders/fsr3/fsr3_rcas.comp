void RCAS(uvec3 LocalThreadId, uvec3 WorkGroupId, uvec3 Dtid)
{
              uvec2 gxy = ffxRemapForQuad(LocalThreadId . x)+ uvec2(WorkGroupId . x << 4u, WorkGroupId . y << 4u);
    CurrFilter(uvec2(gxy));
    gxy . x += 8u;
    CurrFilter(uvec2(gxy));
    gxy . y += 8u;
    CurrFilter(uvec2(gxy));
    gxy . x -= 8u;
    CurrFilter(uvec2(gxy));
}
