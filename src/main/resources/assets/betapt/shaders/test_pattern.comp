#version 430
// M1 test pattern. No voxels yet: every pixel shoots a ray from the real camera.
// Rays going down hit a flat checkerboard at sea level (y = 64), drawn in world
// coordinates with chunk borders every 16 blocks. Rays going up see a sky gradient
// and a sun dot. If walking and looking around moves this the way the real world
// would move, the camera math is right, and M3 can reuse it for real block rays.

layout(local_size_x = 8, local_size_y = 8) in;
layout(rgba8, binding = 0) uniform writeonly image2D outImage;

uniform ivec2 uResolution;
uniform vec3 uCamPos;       // camera position, world space
uniform vec3 uCamForward;   // unit vectors, world space
uniform vec3 uCamRight;
uniform vec3 uCamUp;
uniform float uTanHalfFov;  // tan(vertical fov / 2)
uniform float uTime;        // seconds, for a slow pulse
uniform vec3 uSunDir;

const float GROUND_Y = 64.0;

vec3 sky(vec3 dir) {
    float t = clamp(dir.y * 0.5 + 0.5, 0.0, 1.0);
    vec3 col = mix(vec3(0.75, 0.85, 1.0), vec3(0.25, 0.45, 0.85), t);
    float sun = smoothstep(0.9990, 0.9995, dot(dir, uSunDir));
    return col + sun * vec3(1.0, 0.9, 0.6);
}

vec3 ground(vec3 hit, float dist) {
    vec2 cell = floor(hit.xz);
    float checker = mod(cell.x + cell.y, 2.0);
    vec3 col = mix(vec3(0.35, 0.55, 0.30), vec3(0.45, 0.65, 0.38), checker);
    // chunk borders every 16 blocks, red along x, blue along z
    vec2 inChunk = mod(hit.xz, 16.0);
    if (inChunk.x < 0.08) col = vec3(0.9, 0.2, 0.2);
    if (inChunk.y < 0.08) col = vec3(0.2, 0.3, 0.9);
    // world origin marker
    if (length(hit.xz) < 1.5) col = vec3(1.0, 1.0, 0.2) * (0.75 + 0.25 * sin(uTime * 3.0));
    // fade into sky with distance, like fog
    float fog = clamp(dist / 256.0, 0.0, 1.0);
    return mix(col, vec3(0.75, 0.85, 1.0), fog * fog);
}

void main() {
    ivec2 px = ivec2(gl_GlobalInvocationID.xy);
    if (px.x >= uResolution.x || px.y >= uResolution.y) return;

    vec2 ndc = (vec2(px) + 0.5) / vec2(uResolution) * 2.0 - 1.0;
    float aspect = float(uResolution.x) / float(uResolution.y);
    vec3 dir = normalize(uCamForward
            + ndc.x * uTanHalfFov * aspect * uCamRight
            + ndc.y * uTanHalfFov * uCamUp);

    vec3 col;
    if (dir.y < -1e-4 && uCamPos.y > GROUND_Y) {
        float t = (GROUND_Y - uCamPos.y) / dir.y;
        col = ground(uCamPos + dir * t, t);
    } else {
        col = sky(dir);
    }
    imageStore(outImage, px, vec4(col, 1.0));
}
