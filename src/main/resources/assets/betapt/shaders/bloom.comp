#version 430
// Quarter-resolution separable HDR bloom for Cinematic mode:
//   uMode 0: 9-tap overlapping tent downsample of uHdr + uSkyFog with Karis anti-firefly weighting & soft-knee bright pass
//   uMode 1: horizontal 13-tap Gaussian blur
//   uMode 2: vertical 13-tap Gaussian blur
layout(local_size_x = 8, local_size_y = 8) in;
layout(binding = 1) uniform sampler2D uSrc;
layout(binding = 2) uniform sampler2D uSkyFog;
layout(rgba16f, binding = 0) uniform writeonly image2D outBloom;
layout(std430, binding = 6) readonly buffer Exposure { float exposure; float avgLum; };

uniform ivec2 uDstSize;
uniform int uMode;
uniform float uBrightness;

vec3 softThreshold(vec3 c) {
    float br = max(c.r, max(c.g, c.b));
    const float thresh = 1.15;
    const float knee = 0.55;
    float soft = clamp(br - thresh + knee, 0.0, 2.0 * knee);
    soft = (soft * soft) / (4.0 * knee + 1e-4);
    float contrib = max(soft, br - thresh) / max(br, 1e-4);
    return min(c * contrib, vec3(5.0));
}

vec3 sampleHdr(vec2 uv, float skyScale) {
    vec3 c = max(textureLod(uSrc, uv, 0.0).rgb, vec3(0.0)) * exposure * uBrightness;
    vec4 sf = textureLod(uSkyFog, uv, 0.0);
    if (sf.a > 0.0) c = mix(c, max(sf.rgb, vec3(0.0)) * skyScale, sf.a);
    return min(c, vec3(12.0));
}

void main() {
    ivec2 px = ivec2(gl_GlobalInvocationID.xy);
    if (px.x >= uDstSize.x || px.y >= uDstSize.y) return;
    vec2 inv = 1.0 / vec2(uDstSize);
    vec2 uv = (vec2(px) + 0.5) * inv;

    if (uMode == 0) {
        // 9-tap overlapping tent filter covers the full 4x4 source footprint smoothly with zero sub-pixel jitter boiling
        vec2 o = inv * 0.5;
        float skyScale = mix(1.0, clamp(exposure, 0.45, 2.2), 0.35) * uBrightness;
        vec3 acc = vec3(0.0);
        float wSum = 0.0;
        for (int dy = -1; dy <= 1; dy++) {
            for (int dx = -1; dx <= 1; dx++) {
                float tw = (dx == 0 ? 2.0 : 1.0) * (dy == 0 ? 2.0 : 1.0);
                vec3 s = softThreshold(sampleHdr(uv + vec2(float(dx), float(dy)) * o, skyScale));
                float kw = tw / (1.0 + max(s.r, max(s.g, s.b)));
                acc += s * kw;
                wSum += kw;
            }
        }
        imageStore(outBloom, px, vec4(acc / max(wSum, 1e-4), 1.0));
        return;
    }

    vec2 dir = uMode == 1 ? vec2(inv.x, 0.0) : vec2(0.0, inv.y);
    const float w[7] = float[](0.19648255, 0.17571363, 0.12170275, 0.06598397, 0.02800156, 0.00930004, 0.00241732);
    vec3 sum = textureLod(uSrc, uv, 0.0).rgb * w[0];
    for (int i = 1; i < 7; i++) {
        vec2 off = dir * float(i) * 1.5;
        sum += (textureLod(uSrc, uv + off, 0.0).rgb + textureLod(uSrc, uv - off, 0.0).rgb) * w[i];
    }
    imageStore(outBloom, px, vec4(sum, 1.0));
}
