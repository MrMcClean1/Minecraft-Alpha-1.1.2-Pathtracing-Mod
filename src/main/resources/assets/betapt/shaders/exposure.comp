#version 430
// Automatic exposure, like a camera adjusting to a dark cave or a bright beach.
// One workgroup samples a 64 x 36 grid of the HDR image and averages the log brightness.
// Adaptation is deliberately partial (Beta-faithful): a scene 100x darker ends up about
// 8x darker on screen instead of being brightened all the way back up, so nights and
// caves still read as dark but stay playable.
layout(local_size_x = 256) in;
layout(binding = 1) uniform sampler2D uHdr;
layout(std430, binding = 6) buffer Exposure { float exposure; float avgLum; };
uniform float uDeltaTime;
uniform float uKey;          // exposure for an average brightness of 1
uniform float uAdapt;        // 0 = fixed exposure, 1 = full adaptation
uniform float uMinExposure, uMaxExposure;

shared float partial[256];

void main() {
    uint i = gl_LocalInvocationID.x;
    float sum = 0.0;
    for (uint k = i; k < 64u * 36u; k += 256u) {
        vec2 uv = (vec2(float(k % 64u), float(k / 64u)) + 0.5) / vec2(64.0, 36.0);
        vec3 c = textureLod(uHdr, uv, 0.0).rgb;
        float l = dot(c, vec3(0.2126, 0.7152, 0.0722));
        sum += log(max(l, 1e-4));
    }
    partial[i] = sum;
    barrier();
    for (uint s = 128u; s > 0u; s >>= 1u) {
        if (i < s) partial[i] += partial[i + s];
        barrier();
    }
    if (i == 0u) {
        float avg = exp(partial[0] / (64.0 * 36.0));
        float target = clamp(uKey * pow(max(avg, 1e-4), -uAdapt), uMinExposure, uMaxExposure);
        float current = exposure > 0.0 ? exposure : target;
        // eyes adapt faster to brightness than to darkness
        float rate = target < current ? 3.0 : 1.2;
        exposure = current + (target - current) * (1.0 - exp(-uDeltaTime * rate));
        avgLum = avg;
    }
}
