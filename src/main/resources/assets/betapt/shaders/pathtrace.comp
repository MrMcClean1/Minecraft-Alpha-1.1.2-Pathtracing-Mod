#version 430
#include "version.glsl"
// M4: path tracing. For each pixel:
//   1. a camera ray finds the visible surface (same grid walk as M3),
//   2. a shadow ray toward the sun (or moon) decides direct sunlight,
//   3. one light-emitting block (torch, lava, glowstone...) is picked from a list
//      and a shadow ray decides whether its light reaches this spot,
//   4. one random bounce ray gathers sky light, or light reflected off whatever it hits.
// One sample per pixel per frame, so the lighting is grainy; the M5 denoiser cleans it.
//
// M5: the result is split so only the noisy part gets smoothed:
//   final colour = surface colour x light + extra
// "light" (noisy) goes to the denoiser; "surface colour" (the texture, sharp) and
// "extra" (glowing blocks, water surface) are multiplied/added back afterwards, so
// textures stay crisp while the light underneath them is averaged.

layout(local_size_x = 8, local_size_y = 8) in;
layout(rgba16f, binding = 0) uniform writeonly image2D outLight;   // incoming light (noisy)
// Sky and fog are shown the way Beta shows them, so they skip exposure: rgb = colour, a = coverage
layout(rgba16f, binding = 1) uniform writeonly image2D outSkyFog;
layout(rgba16f, binding = 2) uniform writeonly image2D outAlbedo;  // surface colour (times what water/ice let through)
layout(rgba16f, binding = 3) uniform writeonly image2D outExtra;   // glow and water surface, added on top
layout(rgba16f, binding = 4) uniform writeonly image2D outGeom;    // xy = surface normal (packed), z = distance, w = 1 if a surface
layout(r32f,    binding = 5) uniform writeonly image2D outDepth;   // M6: exact distance to what the camera sees (water surface if any), -1 = sky

layout(binding = 1) uniform usampler3D uVoxels;
layout(binding = 2) uniform sampler2D uAtlas;
layout(binding = 8) uniform sampler2D uAtlasS;     // M9: LabPBR specular map (terrain_s.png), or a 1x1 "none"
layout(binding = 9) uniform sampler2D uAtlasN;     // M9: LabPBR normal map (terrain_n.png), or a 1x1 "none"
layout(binding = 3) uniform sampler2D uGrass;
layout(binding = 4) uniform sampler2D uFoliage;
layout(binding = 5) uniform usampler3D uBricks; // M7: 1 = something in this 4x4x4 brick, 0 = all air
layout(binding = 6) uniform sampler2DArray uSkins; // M6: every 64 x 32 mob skin, one layer each
layout(binding = 7) uniform sampler2D uClouds;     // M8: Beta's clouds.png, for cloud shadows

layout(std430, binding = 2) readonly buffer Slots  { ivec2 slotChunk[]; };
layout(std430, binding = 3) readonly buffer Info   { uint blockInfo[]; };
layout(std430, binding = 4) readonly buffer Boxes  { vec4 blockBox[]; };
layout(std430, binding = 5) readonly buffer Lights { vec4 lights[]; }; // xyz relative to uCamBlock, w = block id
// M6: mobs as boxes (EntityCapture). Per box: centre + half x | inverse axes rows (+ half y, half z) | albedo.
layout(std430, binding = 7) readonly buffer EntBoxes { vec4 entBox[]; };
// per mob: bounding box min + first box index | max + number of boxes
layout(std430, binding = 8) readonly buffer Ents { vec4 ent[]; };

uniform ivec2 uResolution;
uniform ivec3 uCamBlock;
uniform vec3  uCamFrac;
uniform vec3  uCamForward, uCamRight, uCamUp;
uniform float uTanHalfFov;
uniform vec2  uJitter;       // M8: sub-pixel camera nudge for FSR, pixels (0 without FSR)
uniform vec3  uSkyColor, uFogColor;
uniform vec4  uSunrise;      // Beta's sunrise/sunset glow colour, alpha = strength
uniform vec3  uSunDir;       // towards the sun
uniform float uDaylight;     // 0 night .. 1 day (Beta's curve)
uniform float uMaxDist, uFogStart, uFogEnd;
uniform int uFastLeaves;      // Leaves: Fast: solid, Beta's Fast graphics texture (the tile after the see-through one)
uniform int uGrassOverlay;    // Fancy graphics: 1 + the tile Beta lays over grass sides in the biome's colour (38), 0 on Fast
uniform int   uTileSize;
uniform int   uFrame;
uniform int   uLightCount;
uniform float uRain;
uniform int   uDebugMask;
uniform int   uHandEnt;      // 1 + the traced hand's mob index when blocks mustn't hide it (Hand collision: OFF), else 0
uniform int   uEntityCount;  // mobs to test shadow and bounce rays against (0 = none)    // autotest cost probe: 1 = no sun shadow ray, 2 = no torch ray, 4 = no bounce, 8 = no sun ray from the bounce
// "Look" slider (Beta-faithful <-> realistic), worked out on the CPU, see PathTracer.Look
uniform float uAmbient;      // light floor everywhere (caves, nights)
uniform float uMoon;         // moonlight strength
uniform float uLowSunK;      // how much a low sun still lights flat ground (0 = fully, 1 = real cosine)
uniform float uSkySat;       // how much of the sky's blue colours the light it casts
uniform float uSkyFill;      // multiplier on daylight from the sky (fills shadows; high = Beta's nearly shadowless look)
// M8 cloud shadows: the cloud layer is a flat sheet at uCloud.x (world height); clouds.png gives its shape.
// Texel = (world x + uCloud.y, world z) * uCloud.z + (0, uCloud.w), wrapping every 256 texels, as Beta draws it.
uniform vec4  uCloud;
uniform float uCloudShadow;  // 0 = off .. 1 = a cloud blocks all direct sunlight
uniform float uLavaGlow;
uniform int   uReflections;
uniform int   uPbr;
uniform int   uEffects;      // optional effects, FX_* bits (pt_base.glsl)
uniform float uTime, uWind, uWet; // seconds of game time, wind 0..1, rain wetness here 0..1
uniform int   uBounces;      // 1, 2 or 3 bounces of light          // M9: 1 = use the texture pack's LabPBR maps  // M9: 0 off, 1 water and glass, 2 also metals, diamond, obsidian     // lava's own glow as seen, set from last frame's exposure (PathTracer.lavaGlow)

const int SIZE = 512, SLOTS = 32;
const uint CUBE = 1u, CROSS = 2u, BOX = 3u, LIQUID = 4u;
const uint FLAG_TRANSLUCENT = 1u;
const uint FLAG_BOX_UV = 2u;
const float PI = 3.14159265;

#define BLOCKLUM_DECL layout(std430, binding = 10) readonly buffer BlockLum { uint blockLum[]; };
#include "pt_base.glsl"


// ---------------------------------------------------------------- world access
bool chunkLoaded(ivec3 b) {
    ivec2 c = ivec2(b.x >> 4, b.z >> 4);
    return slotChunk[(c.x & (SLOTS - 1)) + (c.y & (SLOTS - 1)) * SLOTS] == c;
}
// True if the 4x4x4 brick around cell b (relative to uCamBlock) is all air, or not loaded.
bool brickEmpty(ivec3 b) {
    ivec3 w = b + uCamBlock;
    if (w.y < 0 || w.y >= WORLD_TOP || !chunkLoaded(w)) return true;
    return texelFetch(uBricks, ivec3((w.x & (SIZE - 1)) >> 2, w.y >> 2, (w.z & (SIZE - 1)) >> 2), 0).r == 0u;
}
uint voxel(ivec3 b) { // b relative to uCamBlock
    ivec3 w = b + uCamBlock;
    if (w.y < 0 || w.y >= WORLD_TOP || !chunkLoaded(w)) return 0u;
    return texelFetch(uVoxels, ivec3(w.x & (SIZE - 1), w.y, w.z & (SIZE - 1)), 0).r;
}
// Pipes and cables (box conditions 7-12): an arm toward a neighbour it would join (the same block, a modded
// block such as a machine or another pipe, or a chest, furnace or dispenser). 7 west, 8 east, 9 north, 10 south, 11 down, 12 up.
bool joins(uint n, uint id) { return n != 0u && (n == id || n >= 97u || n == 23u || n == 54u || n == 61u || n == 62u); }
bool armOk(uint cond, ivec3 c, uint id) {
    ivec3 d = cond == 7u ? ivec3(-1, 0, 0) : cond == 8u ? ivec3(1, 0, 0) : cond == 9u ? ivec3(0, 0, -1)
            : cond == 10u ? ivec3(0, 0, 1) : cond == 11u ? ivec3(0, -1, 0) : ivec3(0, 1, 0);
    return joins(voxel(c + d) & 4095u, id);
}

// bits from BlockCapture.orientation: 1 swap u and v, 2 flip u, 4 flip v
vec2 orientUV(vec2 uv, uint o) {
    if ((o & 1u) != 0u) uv = uv.yx;
    if ((o & 2u) != 0u) uv.x = 1.0 - uv.x;
    if ((o & 4u) != 0u) uv.y = 1.0 - uv.y;
    return uv;
}

vec4 atlas(uint tile, vec2 uv) {
    ivec2 t = ivec2(int(tile & (GRID_COLS - 1u)), int(tile >> GRID_SHIFT)) * uTileSize;
    ivec2 px = t + clamp(ivec2(floor(uv * float(uTileSize))), ivec2(0), ivec2(uTileSize - 1));
    return texelFetch(uAtlas, px, 0);
}

int faceOf(vec3 n) {
    if (n.y < -0.5) return 0;
    if (n.y > 0.5) return 1;
    if (n.z < -0.5) return 2;
    if (n.z > 0.5) return 3;
    if (n.x < -0.5) return 4;
    return 5;
}
vec2 faceUV(int face, vec3 p) {
    if (face <= 1) return vec2(p.x, p.z);
    if (face == 2) return vec2(1.0 - p.x, 1.0 - p.y);
    if (face == 3) return vec2(p.x, 1.0 - p.y);
    if (face == 4) return vec2(p.z, 1.0 - p.y);
    return vec2(1.0 - p.z, 1.0 - p.y);
}
vec3 tintFor(uint tintType, ivec3 b, uint entry) {
    if (tintType == 5u) { uint c = blockInfo[entry * 9u + 8u]; return vec3((c >> 16) & 255u, (c >> 8) & 255u, c & 255u) / 255.0; } // a modded block's own colour
    ivec3 w = b + uCamBlock;
    ivec2 col = ivec2(w.x & (SIZE - 1), w.z & (SIZE - 1));
    if (tintType == 1u) return texelFetch(uGrass, col, 0).rgb;
    if (tintType == 2u) return texelFetch(uFoliage, col, 0).rgb;
    if (tintType == 3u) return vec3(0x61, 0x99, 0x61) / 255.0;
    if (tintType == 4u) return vec3(0x80, 0xA7, 0x55) / 255.0;
    return vec3(1.0);
}

// ---------------------------------------------------------------- the grid walk
struct Hit {
    bool  hit;
    float t;
    vec3  n;
    vec3  albedo;   // linear
    float glow;     // how much of this texel gives off light (flame yes, torch stick no)
    uint  id;
    ivec3 cell;
    vec3  transmit; // colour that got through water/ice on the way
    // first see-through surface (primary rays only, for water shading)
    bool  water;
    vec3  waterColor;
    vec3  waterN;   // the face it went in through (shading for ice and modded see-through blocks)
    float waterAlpha;
    float waterT;
    uint  ent;      // 0 = the world, else 1 + index of the mob hit (its motion, for the denoiser and FSR)
    uint  tile;     // M9: atlas tile and position on it at the hit, for PBR maps (tile >= 256: none)
    vec2  uv;
    bool  glass;    // M9: a camera ray went through a clear glass pixel (first one): where, and its face
    float glassT;
    vec3  glassN;
};

uint liquidKind(uint id) { return id == 8u ? 9u : id == 10u ? 11u : id; } // water's two ids are one water, lava's one lava

bool hitBox(vec3 o, vec3 invD, vec3 bmin, vec3 bmax, float tMin, float tMaxV, out float tHit, out vec3 n) {
    vec3 t0 = (bmin - o) * invD, t1 = (bmax - o) * invD;
    vec3 tn = min(t0, t1), tf = max(t0, t1);
    float tNear = max(max(tn.x, tn.y), tn.z), tFar = min(min(tf.x, tf.y), tf.z);
    if (tNear > tFar || tFar < tMin + 1e-4 || tNear > tMaxV) return false;
    tHit = max(tNear, tMin);
    n = vec3(0.0);
    if (tNear == tn.x) n.x = -sign(1.0 / invD.x);
    else if (tNear == tn.y) n.y = -sign(1.0 / invD.y);
    else n.z = -sign(1.0 / invD.z);
    return true;
}

// M6: mobs. Each is a group of rotated boxes with Beta's skin layout. The nearest box along the
// ray (before maxT) wins; each mob's bounding box is tested first, so rays only look at the parts
// of mobs they pass near. A part is a rotated box: the ray is moved into the box's own axes
// (inverse matrix), where it's a plain box test. The texture is looked up the way Beta lays a
// box's six faces out on the skin (a 64 x 64 layer; Beta's 64 x 32 skins fill its top half); see-through
// pixels let the ray carry on.
// Per box (6 vec4): centre + half x | inverse axes rows (+ half y, half z) | albedo + skin layer |
// texture offset u, v, row scale (negative: mirrored), box size in texels packed as x + y*256 + z*65536.
// The row scale turns the model's v into the layer's rows (1, or 2 for a 64 x 64 texture on a 64 x 32 model).
vec4 skinTexel(vec4 meta, float layer, vec3 f, vec3 ln) {
    float u0 = meta.x, v0 = meta.y;
    bool mir = meta.z < 0.0;
    float vScale = abs(meta.z);
    bool both = vScale > 8.0;                        // a texture of another width: u and v both scaled
    if (both) vScale -= 8.0;
    int pk = int(meta.w + 0.5);
    float dx = float(pk & 255), dy = float((pk >> 8) & 255), dz = float(pk >> 16);
    float gx = mir ? 1.0 - f.x : f.x;               // mirrored parts swap left and right
    vec2 uv;
    if (ln.x != 0.0) {
        bool face0 = (ln.x > 0.0) != mir;           // face 0 sits on the "x1" side of the box
        uv = face0 ? vec2(u0 + dz + dx + f.z * dz, v0 + dz + f.y * dy)
                   : vec2(u0 + (1.0 - f.z) * dz,  v0 + dz + f.y * dy);
    } else if (ln.y < 0.0) uv = vec2(u0 + dz + gx * dx,      v0 + (1.0 - f.z) * dz);
    else if (ln.y > 0.0)   uv = vec2(u0 + dz + dx + gx * dx, v0 + f.z * dz);
    else if (ln.z < 0.0)   uv = vec2(u0 + dz + gx * dx,      v0 + dz + f.y * dy);
    else                   uv = vec2(u0 + 2.0 * dz + dx + (1.0 - gx) * dx, v0 + dz + f.y * dy);
    if (both) uv *= vScale; else uv.y *= vScale;
    ivec2 px = clamp(ivec2(floor(uv)), ivec2(0), ivec2(63, 63));
    return texelFetch(uSkins, ivec3(px, int(layer)), 0);
}

bool traceEntitiesIn(vec3 o, vec3 d, int eFrom, int eTo, inout float maxT, out vec3 n, out vec3 albedo, out uint entHit) {
    bool any = false;
    entHit = 0u;
    n = vec3(0, 1, 0); albedo = vec3(0.5);
    vec3 invD = 1.0 / d;
    for (int e = eFrom; e < eTo; e++) {
        vec4 lo = ent[e * 2], hi = ent[e * 2 + 1];
        vec3 t0 = (lo.xyz - o) * invD, t1 = (hi.xyz - o) * invD;
        vec3 tn = min(t0, t1), tf = max(t0, t1);
        float tNear = max(max(tn.x, tn.y), tn.z), tFar = min(min(tf.x, tf.y), tf.z);
        if (tNear > tFar || tFar < 0.0 || tNear > maxT) continue;
        int first = int(lo.w), count = int(hi.w);
        for (int k = first; k < first + count; k++) {
            vec4 c = entBox[k * 6], r0 = entBox[k * 6 + 1], r1 = entBox[k * 6 + 2], r2 = entBox[k * 6 + 3];
            vec3 hs = vec3(c.w, r0.w, r1.w); // half size
            vec3 rel = o - c.xyz;
            vec3 lo3 = vec3(dot(r0.xyz, rel), dot(r1.xyz, rel), dot(r2.xyz, rel));
            vec3 ld = vec3(dot(r0.xyz, d), dot(r1.xyz, d), dot(r2.xyz, d));
            vec3 li = 1.0 / mix(ld, vec3(1e-8), lessThan(abs(ld), vec3(1e-8)));
            vec3 a0 = (-hs - lo3) * li, a1 = (hs - lo3) * li;
            vec3 an = min(a0, a1), af = max(a0, a1);
            float bn = max(max(an.x, an.y), an.z), bf = min(min(af.x, af.y), af.z);
            // "<= maxT + tiny": an overlay drawn later in the same place (sheep wool, armour, spider
            // eyes) wins over the box under it
            if (bn > bf || bf < 1e-3 || bn > maxT + 1e-4) continue;
            float th = max(bn, 0.0);
            vec3 ln = vec3(0.0);
            if (bn == an.x) ln.x = -sign(ld.x); else if (bn == an.y) ln.y = -sign(ld.y); else ln.z = -sign(ld.z);
            vec4 a4 = entBox[k * 6 + 4];
            if (a4.w < -1.5) {
                // tint overlay (hurt flash, creeper flash): same box as the part under it, so it only
                // recolours a hit at the same distance (front face, or back face seen through a gap).
                // Beta blends it on screen, in display colours, so mix there too.
                if (any && (abs(th - maxT) < 1e-3 || abs(bf - maxT) < 1e-3))
                    albedo = srgbToLinear(mix(pow(albedo, vec3(1.0 / 2.2)), pow(a4.xyz, vec3(1.0 / 2.2)), r2.w));
                continue;
            }
            vec3 col = a4.xyz;
            if (a4.w >= 0.0) {
                vec3 f = clamp((lo3 + ld * th + hs) / (2.0 * hs), 0.0, 1.0); // where on the box, 0..1 per axis
                vec4 tex = skinTexel(entBox[k * 6 + 5], a4.w, f, ln);
                // bn < 0: the ray starts inside this box (light rays from a far face it hit), so its
                // near face is behind it and only the far face counts
                if (bn < 1e-4 || tex.a < 0.5) {
                    // see-through pixel: Beta draws a box's far faces too, so look at the far face from
                    // inside (a chicken's legs and feet are painted on the back and bottom faces)
                    th = bf;
                    if (th > maxT + 1e-4) continue;
                    vec3 fl = vec3(0.0);
                    if (bf == af.x) fl.x = sign(ld.x); else if (bf == af.y) fl.y = sign(ld.y); else fl.z = sign(ld.z);
                    f = clamp((lo3 + ld * th + hs) / (2.0 * hs), 0.0, 1.0);
                    tex = skinTexel(entBox[k * 6 + 5], a4.w, f, fl);
                    if (tex.a < 0.5) continue;
                    ln = -fl; // lit on the side facing the ray
                }
                col = srgbToLinear(tex.rgb) * a4.xyz; // tint (dyed wool etc.), already linear from EntityCapture
            }
            n = normalize(r0.xyz * ln.x + r1.xyz * ln.y + r2.xyz * ln.z); // back into the world: transpose of the inverse axes
            albedo = col;
            maxT = th;
            any = true;
            entHit = uint(e) + 1u;
        }
    }
    return any;
}

bool traceEntities(vec3 o, vec3 d, inout float maxT, out vec3 n, out vec3 albedo, out uint entHit) {
    return traceEntitiesIn(o, d, 0, uEntityCount, maxT, n, albedo, entHit);
}

// o: ray origin relative to uCamBlock. Walks up to maxT blocks.
Hit trace(vec3 o, vec3 d, float maxT, bool primary) {
    Hit h;
    h.hit = false; h.t = maxT; h.n = vec3(0, 1, 0); h.albedo = vec3(0); h.glow = 0.0; h.id = 0u; h.cell = ivec3(0); h.ent = 0u; h.tile = 65535u; h.uv = vec2(0.0);
    h.glass = false; h.glassT = 0.0; h.glassN = vec3(0, 1, 0);
    h.transmit = vec3(1.0); h.water = false; h.waterColor = vec3(0); h.waterN = vec3(0, 1, 0); h.waterAlpha = 0.0; h.waterT = 0.0;

    d += vec3(equal(d, vec3(0.0))) * 1e-7;
    vec3 invD = 1.0 / d;
    ivec3 cell = ivec3(floor(o));
    ivec3 stepDir = ivec3(sign(d));
    vec3 tDelta = abs(invD);
    vec3 tMax = (vec3(cell) + vec3(max(stepDir, ivec3(0))) - o) * invD;
    float t = 0.0;
    uint insideTranslucent = 0u;
    // Water swallows red light quickly and blue slowly, so the deeper the water, the bluer
    // and darker what's under it (Beta gets a similar look by dropping light levels in water).
    const vec3 WATER_ABSORB = vec3(0.55, 0.32, 0.10); // per block travelled
    float waterEnter = -1.0;
    float firstClearT = 1e30; // where the ray first entered water/ice (for mobs in front of it, see the end)

    for (int i = 0; i < 768; i++) {
        float tExit = min(min(tMax.x, tMax.y), tMax.z);
        int wy = cell.y + uCamBlock.y;
        if ((wy < 0 && stepDir.y <= 0) || (wy >= WORLD_TOP && stepDir.y >= 0) || t > maxT) break;

        // M7 empty-space skipping: a whole brick of air is crossed in one hop to where the ray leaves it.
        if (brickEmpty(cell)) {
            insideTranslucent = 0u;
            if (waterEnter >= 0.0) { h.transmit *= exp(-WATER_ABSORB * max(t - waterEnter, 0.0)); waterEnter = -1.0; }
            vec3 bmin = vec3(((cell + uCamBlock) & ivec3(~3)) - uCamBlock);
            vec3 exitPlane = mix(bmin, bmin + 4.0, greaterThan(d, vec3(0.0)));
            vec3 tExit3 = (exitPlane - o) * invD;
            t = max(min(min(tExit3.x, tExit3.y), tExit3.z), t);
            cell = ivec3(floor(o + d * (t + 1e-4)));
            tMax = (vec3(cell) + vec3(max(stepDir, ivec3(0))) - o) * invD;
            continue;
        }

        uint v = voxel(cell);
        uint id = v & 4095u;
        if (id == 0u) {
            insideTranslucent = 0u;
            if (waterEnter >= 0.0) { h.transmit *= exp(-WATER_ABSORB * max(t - waterEnter, 0.0)); waterEnter = -1.0; }
        }
        if (id != 0u) {
            uint entry = id * 16u + (v >> 12);
            uint info = blockInfo[entry * 9u];
            uint shape = info & 15u, tintType = (info >> 4) & 15u, tintMask = (info >> 8) & 63u, flags = info >> 16;
            vec3 lo = o - vec3(cell);
            float tHit = 0.0;
            vec3 n = vec3(0.0);
            bool found = false;
            vec2 uv = vec2(0.0);
            int face = 1;
            int tileOverride = -1;

            if (shape == CUBE) {
                // Full cubes (most of the world): one fixed box, no table reads.
                if (hitBox(lo, invD, vec3(0.0), vec3(1.0), t, tExit, tHit, n)) {
                    face = faceOf(n);
                    uv = faceUV(face, lo + d * tHit);
                    found = true;
                }
            } else if (shape == LIQUID) {
                // Water and lava: one box with a lowered surface. Kept separate from the multi-box
                // code below: a ray crossing a lake visits dozens of water cells, so each must be cheap.
                vec3 bmin = blockBox[(blockInfo[entry * 9u + 7u] >> 4) * 5u].xyz, bmax = blockBox[(blockInfo[entry * 9u + 7u] >> 4) * 5u + 1u].xyz;
                uint va = voxel(cell + ivec3(0, 1, 0)), above = va & 4095u;
                // the same liquid above: full height (a modded one's still and flowing blocks are neighbouring ids, like oil)
                bool sameLiquid = id <= 9u ? (above == 8u || above == 9u) : id <= 11u ? (above == 10u || above == 11u)
                        : (above == id || above == id + 1u || above + 1u == id) && (blockInfo[(above * 16u + (va >> 12)) * 9u] & 15u) == LIQUID;
                if (sameLiquid) bmax.y = 1.0;
                if (t <= 0.0 && all(greaterThanEqual(lo, bmin)) && all(lessThanEqual(lo, bmax))) {
                    // the ray starts in this liquid (the camera under water): already inside, no surface here
                    insideTranslucent = liquidKind(id);
                    if ((id == 8u || id == 9u) && waterEnter < 0.0) waterEnter = 0.0;
                } else if (hitBox(lo, invD, bmin, bmax, t, tExit, tHit, n)) {
                    face = faceOf(n);
                    uv = faceUV(face, lo + d * tHit);
                    found = true;
                }
            } else if (shape == BOX) {
                // M6: a block is up to 12 boxes (stairs = 2, fence = post + bars...). Pass 1 finds which
                // box the ray hits first, keeping as little as possible per box; pass 2 works out the
                // normal and texture position for that one box only. (Keeping this loop lean matters:
                // the tracer runs ~5 times per pixel and every extra value it holds slows them all.)
                // A box may be tilted (wall torch, lever handle): the ray is moved into the box's own
                // coordinates (local = M * (p - pivot)), tested against a plain box there, and the
                // normal is turned back with M's transpose.
                uint boxWord = blockInfo[entry * 9u + 7u], nBoxes = boxWord & 15u, firstBox = boxWord >> 4;
                float best = 1e30;
                uint bestK = 0u;
                for (uint k = 0u; k < nBoxes; k++) {
                    uint base = (firstBox + k) * 5u;
                    vec4 a = blockBox[base];
                    uint cond = uint(a.w + 0.5) & 15u;
                    if (cond != 0u) {
                        bool w = (voxel(cell + ivec3(-1, 0, 0)) & 4095u) == id, e = (voxel(cell + ivec3(1, 0, 0)) & 4095u) == id;
                        bool ok = cond == 1u ? w : cond == 2u ? e
                                : cond == 3u ? (voxel(cell + ivec3(0, 0, -1)) & 4095u) == id
                                : cond == 4u ? (voxel(cell + ivec3(0, 0, 1)) & 4095u) == id
                                : cond == 5u ? (w || e) : cond == 6u ? !(w || e) : armOk(cond, cell, id);
                        if (!ok) continue;
                    }
                    vec3 lo3 = a.xyz, hi3 = blockBox[base + 1u].xyz;
                    vec3 ro = lo, rinv = invD;
                    vec4 m0 = blockBox[base + 2u];
                    if (m0.x != 0.0 || m0.y != 0.0 || m0.z != 0.0) {
                        vec4 m1 = blockBox[base + 3u], m2 = blockBox[base + 4u];
                        mat3 Mt = mat3(m0.xyz, m1.xyz, m2.xyz); // columns = M's rows, so v * Mt = M * v
                        ro = (lo - vec3(m0.w, m1.w, m2.w)) * Mt;
                        vec3 rd = d * Mt;
                        rinv = 1.0 / mix(rd, vec3(1e-8), lessThan(abs(rd), vec3(1e-8)));
                    }
                    float th; vec3 nn;
                    if (hitBox(ro, rinv, lo3, hi3, t, tExit, th, nn) && th < best) { best = th; bestK = k; found = true; }
                }
                if (found) {
                    tHit = best;
                    uint base = (firstBox + bestK) * 5u;
                    vec4 a = blockBox[base], c = blockBox[base + 1u], m0 = blockBox[base + 2u];
                    vec3 lo3 = a.xyz, hi3 = c.xyz;
                    vec3 ro = lo, rd = d, rinv = invD;
                    mat3 Mt = mat3(1.0);
                    bool tilted = m0.x != 0.0 || m0.y != 0.0 || m0.z != 0.0;
                    if (tilted) {
                        vec4 m1 = blockBox[base + 3u], m2 = blockBox[base + 4u];
                        Mt = mat3(m0.xyz, m1.xyz, m2.xyz);
                        ro = (lo - vec3(m0.w, m1.w, m2.w)) * Mt;
                        rd = d * Mt;
                        rinv = 1.0 / mix(rd, vec3(1e-8), lessThan(abs(rd), vec3(1e-8)));
                    }
                    float th; vec3 nn;
                    hitBox(ro, rinv, lo3, hi3, t, tExit, th, nn);
                    face = faceOf(nn);                        // which side of the box: picks the texture
                    n = tilted ? normalize(Mt * nn) : nn;      // the real direction it faces: for lighting
                    vec3 hp = ro + rd * tHit;
                    if ((uint(a.w + 0.5) & 16u) != 0u || (flags & FLAG_BOX_UV) != 0u) { // texture centred on the stick
                        vec3 cc = (lo3 + hi3) * 0.5;
                        hp = vec3(hp.x - cc.x + 0.5, hp.y - lo3.y, hp.z - cc.z + 0.5);
                    }
                    uv = faceUV(face, hp);
                    tileOverride = c.w > 0.5 ? int(c.w + 0.5) - 1 : -1;
                }
            } else if (shape == CROSS) {
                float best = 1e30;
                for (int k = 0; k < 2; k++) {
                    vec3 pn = k == 0 ? vec3(1, 0, -1) : vec3(1, 0, 1);
                    float denom = k == 0 ? (d.x - d.z) : (d.x + d.z);
                    float num = k == 0 ? -(lo.x - lo.z) : (1.0 - lo.x - lo.z);
                    if (abs(denom) < 1e-6) continue;
                    float tp = num / denom;
                    if (tp < t + 1e-4 || tp > tExit || tp >= best) continue;
                    vec3 p = lo + d * tp;
                    if (any(lessThan(p, vec3(0.0))) || any(greaterThan(p, vec3(1.0)))) continue;
                    vec2 cuv = vec2(k == 0 ? p.x : 1.0 - p.x, 1.0 - p.y);
                    cuv += swayUV(id, cell + uCamBlock, p.y); // Waving plants
                    if (atlas(blockInfo[entry * 9u + 3u] & 0xFFFFu, cuv).a <= ALPHA_CUT) continue;
                    best = tp; tHit = tp; uv = cuv; face = 2; found = true;
                    n = normalize(pn) * -sign(dot(d, pn));
                }
            }

            if (found) {
                uint tw = tileOverride >= 0 ? uint(tileOverride) : blockInfo[entry * 9u + 1u + uint(face)];
                uint tile = tw & 0xFFFFu;
                uv = orientUV(uv, tw >> 16u); // a face whose texture the block's model turns
                if (id == 2u && face >= 2) {
                    uint above = voxel(cell + ivec3(0, 1, 0)) & 4095u;
                    if (above == 78u || above == 80u) tile = 68u;
                }
                bool solidLeaf = (uFastLeaves != 0 || gSolidLeaves) && id == 18u;
                if (solidLeaf) tile += 1u;
                else if (id == 18u) uv += swayUV(id, cell + uCamBlock, 0.0); // Waving leaves
                vec4 tex = atlas(tile, uv);
                if (solidLeaf) tex.a = 1.0;
                bool translucent = (flags & FLAG_TRANSLUCENT) != 0u;
                if (tex.a > ALPHA_CUT || (translucent && tex.a > 0.0)) {
                    vec3 albedo = tex.rgb;
                    if ((tintMask & (1u << uint(face))) != 0u) albedo *= tintFor(tintType, cell, entry);
                    if (id == 2u && face >= 2 && tile != 68u && uGrassOverlay > 0) { // Fancy grass: the side's grass edge in the biome's colour
                        vec4 ov = atlas(uint(uGrassOverlay - 1), uv);
                        albedo = mix(albedo, ov.rgb * tintFor(1u, cell, entry), step(0.1, ov.a)); // drawn with alpha test, as Beta does: a pixel covers or it doesn't
                    }
                    albedo = srgbToLinear(albedo);
                    if (translucent) {
                        if (insideTranslucent != liquidKind(id)) { // still and flowing water are one body of water
                            firstClearT = min(firstClearT, tHit);
                            float a = clamp(tex.a, 0.35, 0.9);
                            if ((id == 8u || id == 9u) && waterEnter < 0.0) waterEnter = tHit;
                            if (primary && !h.water) {
                                h.water = true; h.waterColor = albedo; h.waterN = n; h.waterAlpha = a; h.waterT = tHit;
                            }
                            h.transmit *= mix(vec3(1.0), albedo * 1.4, a); // tint what's behind
                        }
                        insideTranslucent = liquidKind(id);
                    } else {
                        if (waterEnter >= 0.0) h.transmit *= exp(-WATER_ABSORB * max(tHit - waterEnter, 0.0));
                        h.hit = true; h.t = tHit; h.n = (shape == CROSS) ? vec3(0, 1, 0) : n;
                        h.albedo = albedo; h.id = id; h.cell = cell; h.tile = tile; h.uv = uv;
                        bool flame = id == 50u || id == 51u || id == 76u;
                        h.glow = flame ? smoothstep(0.55, 0.85, max(tex.r, max(tex.g, tex.b))) : 1.0;
                        break; // done walking; a mob in front of this block is still checked below
                    }
                } else if (primary && id == 20u && !h.glass) {
                    // M9: the clear part of glass lets the ray through, but still reflects a little (main())
                    h.glass = true; h.glassT = tHit; h.glassN = n;
                }
            }
        }

        t = tExit;
        if (tMax.x < tMax.y && tMax.x < tMax.z) { cell.x += stepDir.x; tMax.x += tDelta.x; }
        else if (tMax.y < tMax.z) { cell.y += stepDir.y; tMax.y += tDelta.y; }
        else { cell.z += stepDir.z; tMax.z += tDelta.z; }
    }
    // M6: mobs, for every kind of ray (camera, shadow, bounce)
    if (uEntityCount > 0) {
        float tm = h.hit ? h.t : maxT;
        vec3 en, ea;
        uint eh;
        if (traceEntities(o, d, tm, en, ea, eh)) {
            h.hit = true; h.t = tm; h.n = en; h.albedo = ea; h.id = 0u; h.glow = 0.0; h.ent = eh;
            // The block walk ran first and may have passed through water or ice *behind* the mob;
            // that surface isn't in front of the mob, so it mustn't tint it.
            if (firstClearT > tm) { h.water = false; h.transmit = vec3(1.0); }
        }
    }
    // Hand collision OFF: a camera ray sees the traced hand even where a block is nearer (standing against a wall,
    // the hand reaches into it; Beta draws it on top). It's lit from just in front of that block, where the
    // light reaching the hand comes from, not from inside it.
    if (primary && uHandEnt > 0 && uHandEnt <= uEntityCount && h.ent != uint(uHandEnt)) {
        float tw = h.hit ? h.t : maxT, th = 3.0;
        vec3 hn, ha;
        uint hh;
        if (traceEntitiesIn(o, d, uHandEnt - 1, uHandEnt, th, hn, ha, hh) && th > tw) {
            h.hit = true; h.t = max(tw - 0.02, 1e-3); h.n = hn; h.albedo = ha; h.id = 0u; h.glow = 0.0; h.ent = hh;
            h.water = false; h.transmit = vec3(1.0); h.glass = false;
        }
    }
    return h;
}

// OpenGL's side of the shared code: rays walk the block grid
Hit traceRay(vec3 o, vec3 d, float maxT, bool primary) { return trace(o, d, maxT, primary); }
Hit traceShadow(vec3 o, vec3 d, float maxT) { return trace(o, d, maxT, false); }
void storeGeom(ivec2 px, vec4 g) { imageStore(outGeom, px, g); }

// the hand-light probe (see probeMain): a 1-group dispatch with uProbeOnly = 1
#define PT_PROBE
uniform int  uProbeOnly;
uniform vec3 uProbeOffset;  // hand probe, from the camera (camera-relative world axes)
uniform vec3 uProbeNormal;
uniform vec3 uGridOrigin;   // corner of the probe grid, relative to uCamBlock
layout(std430, binding = 9) writeonly buffer Probe { vec4 probeOut[]; };

#include "pt_light.glsl"
