#version 430
// M7 render scale: the path tracer can draw at a lower resolution (fewer rays, faster),
// and this stretches the finished picture back up to the window with a Catmull-Rom
// (bicubic) filter: sharper than plain blending between pixels, without the blockiness of
// just repeating them. rcas.comp then sharpens the result.
// Catmull-Rom in 9 bilinear taps instead of 16 (the "Jimenez" trick: pairs of taps that
// share a weight sign are fetched as one bilinear sample in between).
layout(local_size_x = 8, local_size_y = 8) in;
layout(binding = 0) uniform sampler2D uSrc;           // low-resolution image, bilinear filtering on
layout(rgba8, binding = 0) uniform writeonly image2D outImage;
uniform ivec2 uOutSize;
uniform vec2  uSrcSize;

vec3 catmullRom(vec2 uv) {
    vec2 samplePos = uv * uSrcSize;
    vec2 texPos1 = floor(samplePos - 0.5) + 0.5;
    vec2 f = samplePos - texPos1;
    vec2 w0 = f * (-0.5 + f * (1.0 - 0.5 * f));
    vec2 w1 = 1.0 + f * f * (-2.5 + 1.5 * f);
    vec2 w2 = f * (0.5 + f * (2.0 - 1.5 * f));
    vec2 w3 = f * f * (-0.5 + 0.5 * f);
    vec2 w12 = w1 + w2;
    vec2 offset12 = w2 / w12;
    vec2 p0 = (texPos1 - 1.0) / uSrcSize;
    vec2 p3 = (texPos1 + 2.0) / uSrcSize;
    vec2 p12 = (texPos1 + offset12) / uSrcSize;
    vec3 r = vec3(0.0);
    r += textureLod(uSrc, vec2(p0.x,  p0.y), 0.0).rgb * w0.x * w0.y;
    r += textureLod(uSrc, vec2(p12.x, p0.y), 0.0).rgb * w12.x * w0.y;
    r += textureLod(uSrc, vec2(p3.x,  p0.y), 0.0).rgb * w3.x * w0.y;
    r += textureLod(uSrc, vec2(p0.x,  p12.y), 0.0).rgb * w0.x * w12.y;
    r += textureLod(uSrc, vec2(p12.x, p12.y), 0.0).rgb * w12.x * w12.y;
    r += textureLod(uSrc, vec2(p3.x,  p12.y), 0.0).rgb * w3.x * w12.y;
    r += textureLod(uSrc, vec2(p0.x,  p3.y), 0.0).rgb * w0.x * w3.y;
    r += textureLod(uSrc, vec2(p12.x, p3.y), 0.0).rgb * w12.x * w3.y;
    r += textureLod(uSrc, vec2(p3.x,  p3.y), 0.0).rgb * w3.x * w3.y;
    return clamp(r, 0.0, 1.0);
}

void main() {
    ivec2 px = ivec2(gl_GlobalInvocationID.xy);
    if (px.x >= uOutSize.x || px.y >= uOutSize.y) return;
    vec2 uv = (vec2(px) + 0.5) / vec2(uOutSize);
    imageStore(outImage, px, vec4(catmullRom(uv), 1.0));
}
